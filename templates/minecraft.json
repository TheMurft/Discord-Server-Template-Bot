          "type": "GuildText",
          "topic": "Details about ongoing and upcoming network events."
        },
        {
          "name": "🛒-store",
          "type": "GuildText",
          "topic": "Support the server! Rank benefits and store link: store.example.com"
        }
      ]
    },
    {
