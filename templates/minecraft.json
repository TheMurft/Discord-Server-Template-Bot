{
  "templateName": "Minecraft Network Server",
  "description": "Tailored for a Minecraft Network with information, global lobby, game modes, VIP zone, voice channels, and staff areas.",
  "roles": [
    {
      "name": "👑 Owner",
      "color": "#FF0000",
      "hoist": true,
      "permissions": [
        "Administrator"
      ]
    },
    {
      "name": "🛡️ Admin",
      "color": "#E67E22",
      "hoist": true,
      "permissions": [
        "Administrator"
      ]
    },
    {
      "name": "⚔️ Moderator",
      "color": "#2ECC71",
      "hoist": true,
      "permissions": [
        "ManageMessages",
        "KickMembers",
        "BanMembers",
        "MuteMembers"
      ]
    },
    {
      "name": "🤝 Helper",
      "color": "#3498DB",
      "hoist": true,
      "permissions": [
        "ManageMessages",
        "KickMembers"
      ]
    },
    {
      "name": "💎 VIP",
      "color": "#F1C40F",
      "hoist": true,
      "permissions": [
        "AttachFiles",
        "EmbedLinks"
